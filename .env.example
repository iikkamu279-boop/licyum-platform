# ==============================================================================
# LICYUM PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Salin file ini menjadi .env atau .env.local dan sesuaikan kredensial Anda.
# ==============================================================================

# 1. CORE APPLICATION
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_NAME="Licyum Indonesia"
NEXT_PUBLIC_APP_TAGLINE="Ekosistem Terpadu Penerbitan Buku, Jurnal Ilmiah & Pelatihan"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# 2. DATABASE CONFIGURATION ('sqlite' | 'postgres' | 'mysql')
NEXT_PUBLIC_SUPABASE_URL="https://apdaijdbyunemscdbjsp.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY_HERE"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE"
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.apdaijdbyunemscdbjsp.supabase.co:5432/postgres"

DATABASE_TYPE="supabase"
SQLITE_DB_PATH="./database/licyum.db"

# 3. AUTHENTICATION & SINGLE SIGN-ON (SSO)
JWT_SECRET="ganti_dengan_kunci_rahasia_jwt_minimal_32_karakter"
JWT_EXPIRES_IN="7d"
NEXTAUTH_SECRET="ganti_dengan_kunci_rahasia_nextauth"
NEXTAUTH_URL="http://localhost:3000"

# 4. PILAR 1: PENERBITAN (IKAPI & PERPUSNAS ISBN)
NEXT_PUBLIC_IKAPI_MEMBER_NUMBER="612/DKI/2022"
PERPUSNAS_ISBN_API_KEY="kunci_api_perpusnas_resmi"
PERPUSNAS_ISBN_ENDPOINT="https://isbn.perpusnas.go.id/api/v2"
DJKI_HAKI_CLIENT_ID="client_id_haki_kemenkumham"
DJKI_HAKI_SECRET="secret_haki_kemenkumham"

# 5. PILAR 2: PORTAL JURNAL (OJS 3 & CROSSREF DOI)
OJS_BASE_URL="https://journal.licyum.id"
OJS_API_KEY="api_key_ojs_pkp"
CROSSREF_DOI_PREFIX="10.58921"
CROSSREF_USERNAME="username_crossref"
CROSSREF_PASSWORD="password_crossref"
TURNITIN_ACCOUNT_ID="account_id_turnitin"
TURNITIN_API_KEY="api_key_turnitin_no_repository"

# 6. PILAR 3: PELATIHAN & SERTIFIKASI
CERTIFICATE_SIGNER_NAME="Prof. Dr. Agus Raharjo, M.Si."
CERTIFICATE_SIGNER_TITLE="Direktur Eksekutif Licyum Institute"
CERTIFICATE_SECRET_HMAC="kunci_rahasia_verifikasi_qr_sertifikat"
BNSP_INSTITUTE_CODE="LPK-LIC-BNSP-2026"
ZOOM_API_CLIENT_ID="zoom_oauth_client_id"
ZOOM_API_CLIENT_SECRET="zoom_oauth_client_secret"

# 7. KONTAK & PAYMENT GATEWAY
NEXT_PUBLIC_WHATSAPP_NUMBER="6281234567890"
NEXT_PUBLIC_SUPPORT_EMAIL="redaksi@licyum.id"
NEXT_PUBLIC_OFFICE_PHONE="(021) 7891-234"
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxx"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxx"
MIDTRANS_IS_PRODUCTION=false
